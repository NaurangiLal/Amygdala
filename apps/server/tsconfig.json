{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    // Colyseus schema's decorator-free schema() factory is fine, but the
    // library's own types pull in experimental decorator metadata; skipLibCheck
    // (from the base) keeps that out of our build. Our own code stays erasable.
    "moduleResolution": "NodeNext"
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
